# Get a free key at https://app.tavily.com
# Leave empty to run in mock mode (bundled fixture pages, no network calls)
TAVILY_API_KEY="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"

# Search behaviour
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# Pipeline behaviour
DEFAULT_PARSER=baseline
FETCH_TIMEOUT=20
MAX_FETCH_BYTES=5000000
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Databricks (only used by `web-ingest index`) ---------------------------
# Service principal auth (CI/CD style). Leave the two SPN values empty to fall
# back to ambient auth (Databricks CLI / VS Code extension / ~/.databrickscfg).
DATABRICKS_HOST=""
DATABRICKS_CLIENT_ID=""
DATABRICKS_CLIENT_SECRET=""
# SQL warehouse used to write the chunks table
DATABRICKS_WAREHOUSE_ID=""

# Unity Catalog target for the chunks table + vector index
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=web_ingest
DATABRICKS_TABLE=web_chunks
DATABRICKS_DOCUMENTS_TABLE=web_documents
DATABRICKS_ENDPOINT_NAME=vector-search-web-endpoint
DATABRICKS_INDEX_NAME=web_chunks_index
DATABRICKS_EMBEDDING_MODEL=databricks-gte-large-en
